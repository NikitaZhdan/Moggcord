# Общий секрет для подписи/проверки JWT — ОДИНАКОВЫЙ для Java и Python сервисов.
# Должен быть валидной base64-строкой (Java декодирует её как base64, см. README.md).
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=ZmFrZS1zZWNyZXQta2V5LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uIQ==

# Адреса, по которым БРАУЗЕР пользователя будет достигать бэкендов.
# Для локального запуска можно не менять.
PUBLIC_AUTH_URL=http://localhost:8080
PUBLIC_CHAT_URL=http://localhost:8000
PUBLIC_CHAT_WS_URL=ws://localhost:8000
